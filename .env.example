# Optional MySQL/MariaDB URL. Omit locally to use the convenient SQLite development/test database.
# Production requires this setting; keep the real URL in a private environment, never in source control.
MYSQL_URL=

# Use a long, unique password for initial administrator creation.
# Remove ADMIN_PASSWORD after the administrator has been created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=admin

# Directory for uploaded media and private originals; defaults to ./data.
DATA_DIRECTORY=
PORT=4173
