# Use a long, unique password for initial administrator creation.
# Remove ADMIN_PASSWORD after the administrator has been created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=admin

# Directory for uploaded media and private originals; defaults to ./data.
DATA_DIRECTORY=
PORT=4173

# Local or standalone MySQL connection for migrations and recovery tooling.
# Do not use this variable in frontend code or commit a real connection string.
MYSQL_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
MYSQL_SSL=true

# Public application origin used when constructing absolute links.
APP_URL=https://example.com
