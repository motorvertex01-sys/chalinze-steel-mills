{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chalinze-steel-mills-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chalinze-steel-mills",
      "database_id": "df36e9ae-dad2-4606-aceb-9e7d7408d9d6",
      "migrations_dir": "migrations"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "replace-with-hyperdrive-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "chalinze-steel-mills-media"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "admin@chalinze.co.tz"
  }
}
