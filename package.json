{
  "name": "chalinze-steel-mills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "admin:create": "node server/create-admin.js",
    "admin:reset:cloudflare": "node scripts/reset-cloudflare-admin.mjs",
    "db:migrate:mysql": "node scripts/migrate-mysql.mjs",
    "db:import:render:d1": "node scripts/import-render-to-d1.mjs",
    "db:backup:mysql": "node scripts/backup-mysql.mjs",
    "db:restore:mysql": "node scripts/restore-mysql.mjs",
    "db:verify:mysql": "node scripts/verify-sqlite-mysql.mjs",
    "admin:reset:mysql": "node scripts/reset-mysql-admin.mjs",
    "test": "node --test",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run typecheck:worker && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "hono": "^4.13.16",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.172.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.158.0"
  }
}
